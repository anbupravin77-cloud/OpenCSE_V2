# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this platform is hosted (used for sitemap and canonical links).
APP_URL="https://opencse.org"

# CONTACT_EMAIL: Email address shown on the /contact page and legal notices, and destination for contact form.
CONTACT_EMAIL="anbupravin77@gmail.com"
VITE_CONTACT_EMAIL="anbupravin77@gmail.com"

# --- SMTP CONFIGURATION FOR CONTACT FORM ---
# These are required to send emails via the contact form. Do NOT commit actual passwords.
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_USER="user@example.com"
SMTP_PASS="your_secure_app_password"

# ADMIN_PASSWORD: Password for admin panel login (/admin/login). Default is "admin".
ADMIN_PASSWORD="admin"

# VITE_ADSENSE_CLIENT: Optional Google AdSense Publisher Client ID (e.g. ca-pub-xxxxxxxxxxxxxxxx).
# Leave empty until your AdSense account is approved.
VITE_ADSENSE_CLIENT=""

# VITE_GOOGLE_SITE: Optional Google Search Console site verification code.
VITE_GOOGLE_SITE=""

# ADS_TXT_CONTENT: Optional custom content for the /ads.txt endpoint.
# Leave empty until AdSense publisher details are provided.
ADS_TXT_CONTENT=""

# PORT: Server port (defaults to 3000 or process.env.PORT on Render/Cloud Run).
PORT=3000
